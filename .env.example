# Project
PROJ_DIR=/path/to/project/base/directory/here
STUB_MODE=1
DEBUG=1
MODEL_BACKEND=ridge

# Hosted public API: set PUBLIC_DEMO=1, STUB_MODE=0, DEBUG=0.
# Shared server-side history and live backtests are disabled.
PUBLIC_DEMO=0
CORS_ORIGINS=[]

# Supabase account deployment. Keep DEBUG=0 and use asymmetric signing keys.
AUTH_ENABLED=0
SUPABASE_URL=https://your-project.supabase.co
# Backend only: never copy this key into a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
