# Project
PROJ_DIR=/path/to/project/base/directory/here
STUB_MODE=1
DEBUG=1
MODEL_BACKEND=ridge

# Gemini player research (server-side only; optional for predictions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
RESEARCH_TIMEOUT_SECONDS=60

# Hosted public API: set PUBLIC_DEMO=1, STUB_MODE=0, DEBUG=0.
# Shared server-side history, live backtests and Gemini research are disabled.
PUBLIC_DEMO=0
CORS_ORIGINS=[]
