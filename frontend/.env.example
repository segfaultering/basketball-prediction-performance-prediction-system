# Normal local API mode is the default. For the hosted portfolio demo:
VITE_PORTFOLIO_DEMO=1
VITE_BASE_PATH=/
# Public API address, never an API key. Leave blank for a same-origin local API.
VITE_API_BASE_URL=https://your-api.onrender.com

# Enable for the account deployment; defaults to disabled for local demos.
VITE_AUTH_ENABLED=0
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use a publishable (sb_publishable_...) or legacy anon key, never service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
