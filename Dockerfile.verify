FROM node:22-bookworm-slim AS node
FROM python:3.14-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /usr/local/bin/
COPY --from=node /usr/local/ /usr/local/
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy \
    UV_CONCURRENT_INSTALLS=1 UV_CONCURRENT_BUILDS=1 \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    NODE_OPTIONS=--max-old-space-size=1024 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN --mount=type=cache,id=courtside-uv,target=/root/.cache/uv uv sync --frozen --group research
COPY frontend/package.json frontend/package-lock.json ./frontend/
# Libraries required by Chromium headless shell on Debian 12. No desktop/Xvfb.
RUN apt-get update && apt-get install -y --no-install-recommends \
    fontconfig fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 \
    libcairo2 libcups2 libdbus-1-3 libdrm2 libexpat1 libgbm1 libglib2.0-0 \
    libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,id=courtside-npm,target=/root/.npm cd frontend && npm ci
RUN --mount=type=cache,id=courtside-playwright,target=/root/.cache/ms-playwright \
    cd frontend && PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    npx playwright install --only-shell chromium \
    && mkdir -p /opt/playwright \
    && cp -a /root/.cache/ms-playwright/. /opt/playwright/
COPY tests ./tests
COPY examples ./examples
COPY frontend ./frontend
COPY scripts ./scripts
COPY notebooks ./notebooks
CMD ["sh", "scripts/verify-low-memory.sh"]
